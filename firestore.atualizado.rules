rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function ehDono(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // Estrutura nova: cada usuário possui sua própria subcoleção de pontos.
    match /usuarios/{uid}/pontos/{dia} {
      allow read: if ehDono(uid);

      allow create: if ehDono(uid)
                    && request.resource.data.ownerUid == uid;

      allow update: if ehDono(uid)
                    && resource.data.ownerUid == uid
                    && request.resource.data.ownerUid == uid;

      // A aplicação não exclui pontos automaticamente.
      allow delete: if false;
    }

    // Preserva as duas versões quando há conflito na migração convidado -> Google.
    match /usuarios/{uid}/conflitosPontos/{conflitoId} {
      allow read: if ehDono(uid);

      allow create: if ehDono(uid)
                    && request.resource.data.ownerUid == uid;

      allow update: if ehDono(uid)
                    && resource.data.ownerUid == uid
                    && request.resource.data.ownerUid == uid;

      allow delete: if false;
    }

    // Coleção antiga: compatibilidade temporária durante a implantação.
    // A consulta do cliente inclui where("ownerUid", "==", request.auth.uid).
    match /pontos/{docId} {
      allow read: if autenticado()
                  && resource.data.ownerUid == request.auth.uid;

      allow create: if autenticado()
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if autenticado()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if false;
    }

    match /configuracoes/{uid} {
      allow read: if ehDono(uid);

      allow create: if ehDono(uid)
                    && request.resource.data.ownerUid == uid;

      allow update: if ehDono(uid)
                    && request.resource.data.ownerUid == uid;

      allow delete: if false;
    }
  }
}
